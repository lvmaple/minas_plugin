# Motrix Web UI under the authenticated NAS plugin origin.
location ~ ^/plugin/u?__UID__/motrix/api/__WS_TICKET__/rpc/events$ {
    if ($need_reject) { return 403; }
    if ($arg_token != "__WS_TICKET__") { return 403; }
    rewrite ^/plugin/u?__UID__/motrix/api/__WS_TICKET__/(.*)$ /$1 break;
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host __NAS_IP__:8080;
    proxy_set_header Origin http://__NAS_IP__:8080;
    proxy_set_header X-Motrix-Web-Origin http://__NAS_IP__:8080;
    proxy_set_header Authorization "Bearer __OPERATOR_TOKEN__";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
    access_log off;
}

location ~ ^/plugin/u?__UID__/motrix/api/__WS_TICKET__/ {
    if ($need_reject) { return 403; }
    rewrite ^/plugin/u?__UID__/motrix/api/__WS_TICKET__/(.*)$ /$1 break;
    proxy_pass http://unix:/run/motrix-web-proxy/proxy.sock:;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    client_max_body_size 64m;
    proxy_read_timeout 120s;
    add_header Cache-Control "no-store" always;
    access_log off;
}
